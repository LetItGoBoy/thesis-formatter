# ==================================================
# 论文格式化工具 - 环境变量配置
# 复制此文件为 .env，填入你的API Key
# ==================================================

# ✅ 选择使用哪个AI提供商（只填一个）
# 可选值: deepseek | qwen | zhipu | moonshot | claude | openai
AI_PROVIDER=deepseek

# --------------------------------------------------
# DeepSeek（推荐）
# 官网: https://platform.deepseek.com
# 价格: 约¥0.001/千tokens，识别一篇论文约¥0.01
# --------------------------------------------------
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------
# 通义千问（备选）
# 官网: https://dashscope.console.aliyun.com
# 价格: qwen-plus约¥0.004/千tokens
# --------------------------------------------------
QWEN_API_KEY=sk-xxx
QWEN_MODEL=qwen-plus

# --------------------------------------------------
# 智谱GLM（备选，有免费额度）
# 官网: https://open.bigmodel.cn
# 价格: glm-4-flash完全免费
# --------------------------------------------------
ZHIPU_API_KEY=xxx.xxx
ZHIPU_MODEL=glm-4-flash

# --------------------------------------------------
# 月之暗面Kimi（备选，长文本强）
# 官网: https://platform.moonshot.cn
# 价格: moonshot-v1-8k约¥0.012/千tokens
# --------------------------------------------------
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_MODEL=moonshot-v1-8k

# --------------------------------------------------
# Anthropic Claude（备用，效果最好但最贵）
# 价格: claude-haiku约¥0.02/千tokens
# --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --------------------------------------------------
# Flask服务地址（前端调用后端）
# --------------------------------------------------
FLASK_URL=http://localhost:5000
FLASK_PORT=5000

# --------------------------------------------------
# 前端配置
# --------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
