      "block": "references",
      "display_name": "参考文献标题",
      "fixed_text": "参考文献",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 14,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 12,
      "first_line_indent_chars": 0,
      "page_break_before": true
    },
    "reference_item": {
