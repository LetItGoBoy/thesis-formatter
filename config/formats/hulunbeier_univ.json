      "display_name": "参考文献正文",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0,
      "hanging_indent_chars": 2
    },
    "ref": {
      "block": "references",
      "display_name": "参考文献（兼容）",
      "legacy": true,
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
