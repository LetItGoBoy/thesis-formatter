    "caption": {
      "block": "body",
      "display_name": "图表题注",
      "legacy": true,
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 10.5,
      "bold": false,
      "alignment": "center",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0
    },
    "conclusion_title": {
