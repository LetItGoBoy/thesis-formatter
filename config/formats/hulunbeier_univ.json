      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 15,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 18,
      "first_line_indent_chars": 0,
      "page_break_before": true
    },
    "conclusion_body": {
      "block": "conclusion",
      "display_name": "总结正文",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
