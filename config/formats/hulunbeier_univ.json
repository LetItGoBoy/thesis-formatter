{
  "name": "呼伦贝尔学院本科毕业论文格式",
  "version": "1.0.0",
  "page": {
    "size": "A4",
    "margin_top_cm": 2.54,
    "margin_bottom_cm": 2.54,
    "margin_left_cm": 3.17,
    "margin_right_cm": 3.17,
    "header_cm": 1.5,
    "footer_cm": 1.75
  },
  "fonts": {
    "chinese_default": "宋体",
    "ascii_default": "Times New Roman",
    "heading_chinese": "黑体"
  },
  "paragraph_styles": {
    "h1": {
      "chinese_font": "黑体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 16,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 24,
      "space_after_pt": 18,
      "first_line_indent_chars": 0,
      "page_break_before": true
    },
    "h2": {
      "chinese_font": "黑体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 14,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "h3": {
      "chinese_font": "黑体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "abstract": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "first_line_indent_chars": 2
    },
    "body": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "first_line_indent_chars": 2
    },
    "ref": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 10.5,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.0,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "first_line_indent_chars": 0,
      "hanging_indent_chars": 2
    },
    "caption": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 10.5,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.0,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "cover": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 16,
      "bold": false,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "toc": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "first_line_indent_chars": 0
    },
    "keywords": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "first_line_indent_chars": 0,
      "label_bold": true
    },
    "conclusion": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 0,
      "first_line_indent_chars": 2
    }
  },
  "table": {
    "cant_split": true,
    "three_line": {
      "enabled": true,
      "top_border_pt": 1.5,
      "bottom_border_pt": 1.5,
      "header_bottom_border_pt": 1.0,
      "inner_border_pt": 0
    },
    "font": {
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 10.5
    },
    "alignment": "center"
  },
  "page_number": {
    "enabled": true,
    "alignment": "center",
    "font": "Times New Roman",
    "font_size_pt": 10.5,
    "format": "1"
  }
}
