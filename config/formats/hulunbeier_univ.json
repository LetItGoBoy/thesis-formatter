      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent_chars": 2,
      "normalize_numbered_prefix": true
    },
    "table_caption": {
      "block": "body",
      "display_name": "表说明",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 10.5,
      "bold": false,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 3,
      "first_line_indent_chars": 0
