{
  "name": "呼伦贝尔学院本科毕业论文格式",
  "version": "2.0.0",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margin_top_cm": 2.5,
    "margin_bottom_cm": 2.0,
    "margin_left_cm": 3.0,
    "margin_right_cm": 2.0,
    "gutter_cm": 0,
    "header_cm": 1.5,
    "footer_cm": 1.75
  },
  "global": {
    "disable_snap_to_grid": true,
    "ascii_font": "Times New Roman",
    "keyword_separator": " ",
    "page_break_per_block": true,
    "page_break_per_chapter_h1": true
  },
  "blocks": {
    "toc": {
      "display_name": "目录大块",
      "order": 1,
      "page_break_before": true,
      "types": ["toc_title", "toc_h1", "toc_h2", "toc_h3"]
    },
    "abstract": {
      "display_name": "摘要大块",
      "order": 2,
      "page_break_before": true,
      "types": [
        "paper_title", "author_line", "instructor",
        "abstract_title_cn", "abstract_body_cn", "keywords_cn",
        "abstract_title_en", "abstract_body_en", "keywords_en"
      ]
    },
    "body": {
      "display_name": "正文大块",
      "order": 3,
      "page_break_before": true,
      "types": [
        "h1", "h2", "h3", "body", "numbered_item",
        "table_caption", "table", "formula", "formula_number",
        "figure_caption", "caption"
      ]
    },
    "conclusion": {
      "display_name": "总结大块",
      "order": 4,
      "page_break_before": true,
      "types": ["conclusion_title", "conclusion_body"]
    },
    "references": {
      "display_name": "参考文献大块",
      "order": 5,
      "page_break_before": true,
      "types": ["references_title", "reference_item", "ref"]
    }
  },
  "paragraph_styles": {
    "toc_title": {
      "block": "toc",
      "display_name": "目录标题",
      "fixed_text": "目  录",
      "chinese_font": "黑体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 16,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 18,
      "first_line_indent_chars": 0
    },
    "toc_h1": {
      "block": "toc",
      "display_name": "一级目录",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0
    },
    "toc_h2": {
      "block": "toc",
      "display_name": "二级目录",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0,
      "leading_full_width_spaces": 2
    },
    "toc_h3": {
      "block": "toc",
      "display_name": "三级目录",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0,
      "leading_full_width_spaces": 4
    },
    "paper_title": {
      "block": "abstract",
      "display_name": "论文题目",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 18,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 0,
      "space_after_pt": 24,
      "first_line_indent_chars": 0
    },
    "author_line": {
      "block": "abstract",
      "display_name": "作者",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "center",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0
    },
    "instructor": {
      "block": "abstract",
      "display_name": "指导老师",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "center",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0
    },
    "abstract_title_cn": {
      "block": "abstract",
      "display_name": "摘要标题（中文）",
      "fixed_text": "摘要",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "abstract_body_cn": {
      "block": "abstract",
      "display_name": "摘要正文（中文）",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent_chars": 2
    },
    "keywords_cn": {
      "block": "abstract",
      "display_name": "关键词（中文）",
      "chinese_font": "仿宋",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "first_line_indent_chars": 0,
      "is_keywords": true,
      "keywords_prefix": "关键词："
    },
    "abstract_title_en": {
      "block": "abstract",
      "display_name": "Abstract标题",
      "fixed_text": "Abstract",
      "chinese_font": "Times New Roman",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 18,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "abstract_body_en": {
      "block": "abstract",
      "display_name": "摘要正文（英文）",
      "chinese_font": "Times New Roman",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent_chars": 0
    },
    "keywords_en": {
      "block": "abstract",
      "display_name": "关键词（英文）",
      "chinese_font": "Times New Roman",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "first_line_indent_chars": 0,
      "is_keywords": true,
      "keywords_prefix": "Keywords:"
    },
    "h1": {
      "block": "body",
      "display_name": "一级标题",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 15,
      "bold": true,
      "alignment": "center",
      "line_spacing": 1.5,
      "space_before_pt": 24,
      "space_after_pt": 18,
      "first_line_indent_chars": 0,
      "page_break_before": true,
      "chapter_two_space_normalize": true
    },
    "h2": {
      "block": "body",
      "display_name": "二级标题",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 14,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 12,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "h3": {
      "block": "body",
      "display_name": "三级标题",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": true,
      "alignment": "left",
      "line_spacing": 1.5,
      "space_before_pt": 6,
      "space_after_pt": 6,
      "first_line_indent_chars": 0
    },
    "body": {
      "block": "body",
      "display_name": "正文",
      "chinese_font": "宋体",
      "ascii_font": "Times New Roman",
      "font_size_pt": 12,
      "bold": false,
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent_chars": 2
    },
    "numbered_item": {
      "block": "body",
      "display_name": "数字序号",
