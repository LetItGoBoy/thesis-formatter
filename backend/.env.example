# ==================================================
# 论文格式化工具 - 后端环境变量
# 复制此文件为 .env，填入你的API Key
# ==================================================

AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=sk-xxx
QWEN_MODEL=qwen-plus

ZHIPU_API_KEY=xxx.xxx
ZHIPU_MODEL=glm-4-flash

MOONSHOT_API_KEY=sk-xxx
MOONSHOT_MODEL=moonshot-v1-8k

# 豆包（字节跳动 Ark 平台）—— 旗舰版默认使用
DOUBAO_API_KEY=ark-xxx
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# ==================================================
# 模型档位（首页选择 经济/标准/旗舰）
# 默认全部走 Moonshot（同一个 MOONSHOT_API_KEY 即可调 8k/32k/128k）。
# 想把某档位换成 deepseek/claude 等，改对应 PROVIDER/MODEL 并配好该家 KEY。
# 未在首页选档位时回退到上面的 AI_PROVIDER。
# ==================================================
DEFAULT_TIER=standard
TIER_ECONOMY_PROVIDER=moonshot
TIER_ECONOMY_MODEL=moonshot-v1-8k
TIER_STANDARD_PROVIDER=moonshot
TIER_STANDARD_MODEL=moonshot-v1-128k
TIER_FLAGSHIP_PROVIDER=doubao
TIER_FLAGSHIP_MODEL=doubao-seed-2-0-pro-260215

# ==================================================
# 识别器选择（实验性）
#   batch_ai    = v1 稳定版：规则跳封面/声明 + 整片批量识别（默认）
#   semantic_v2 = v2 实验版：纯 AI 语义切块 + 块内专属 prompt 分类
# 留空或填 batch_ai 走 v1，不影响现有部署。
# ==================================================
RECOGNIZER=batch_ai

# ==================================================
# 论文表达润色模块（第二个独立工具，不影响识别/格式化）
# 复用现有 MOONSHOT_API_KEY；只改下面变量即可切换润色用的模型。
# ==================================================
POLISH_PROVIDER=moonshot
POLISH_MODEL=moonshot-v1-32k
POLISH_TIMEOUT=120
POLISH_MAX_TOKENS=4096
POLISH_TEMPERATURE=0.3

FLASK_PORT=5000
MAX_UPLOAD_MB=20
MAX_CONTENT_MB=100

# ==================================================
# 用户认证（JWT）
# ==================================================
# 必须设置一个随机强密钥，否则重启后所有登录态失效
JWT_SECRET=换成一个随机长字符串
JWT_EXPIRE_DAYS=7

# ==================================================
# 短信验证码
# SMS_PROVIDER=mock    控制台打印验证码，不发真实短信（开发测试）
# SMS_PROVIDER=aliyun  发真实短信（需下面的阿里云配置 + 安装 SDK）
# ==================================================
SMS_PROVIDER=mock

# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
# 安装SDK: pip install alibabacloud-dysmsapi20170525
ALIYUN_ACCESS_KEY_ID=xxx
ALIYUN_ACCESS_KEY_SECRET=xxx
ALIYUN_SMS_SIGN_NAME=你的签名名称
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
