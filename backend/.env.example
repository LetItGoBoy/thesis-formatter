# ==================================================
# 论文格式化工具 - 后端环境变量
# 复制此文件为 .env，填入你的API Key
# ==================================================

AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=sk-xxx
QWEN_MODEL=qwen-plus

ZHIPU_API_KEY=xxx.xxx
ZHIPU_MODEL=glm-4-flash

MOONSHOT_API_KEY=sk-xxx
MOONSHOT_MODEL=moonshot-v1-8k

ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# ==================================================
# 模型档位（首页选择 经济/标准/旗舰）
# 默认全部走 Moonshot（同一个 MOONSHOT_API_KEY 即可调 8k/32k/128k）。
# 想把某档位换成 deepseek/claude 等，改对应 PROVIDER/MODEL 并配好该家 KEY。
# 未在首页选档位时回退到上面的 AI_PROVIDER。
# ==================================================
DEFAULT_TIER=standard
TIER_ECONOMY_PROVIDER=moonshot
TIER_ECONOMY_MODEL=moonshot-v1-8k
TIER_STANDARD_PROVIDER=moonshot
TIER_STANDARD_MODEL=moonshot-v1-128k
TIER_FLAGSHIP_PROVIDER=moonshot
TIER_FLAGSHIP_MODEL=moonshot-v1-128k

FLASK_PORT=5000
MAX_UPLOAD_MB=20
